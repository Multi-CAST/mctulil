    </TIER>
    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_association" PARENT_REF="utterance_id" PARTICIPANT="TL03" TIER_ID="utterance">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a54" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>(nganə-) nganəngar be apir bema evi mutəre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a55" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>ar bəvon kup, o evi mutəre o mənba tivən ne, ba (vokie ba-) voki ba tivən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a56" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>vənu təgəta, o itek tang mənəmu, ba vokie tədəratəm da ittəlavənung.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a57" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>nəbət to ittəlavənung, məlanga vətəre, nəbət to ittəlavənung.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a58" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>io vətire, ate, "nging o mənəbi nə nging?"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a59" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>ete, "ava ngang o nga məngəda amu, ba vokie emu nəmu ba tivən."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a60" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>io iep itir liu tuka ete, "me nging?"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a61" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>"nging o nginemengəp nəbi?"</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a62" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>'ava ngang o nəbət konəng davə, avar ba vokie ebət.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a63" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>ate, 'io, mərek.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a871" ANNOTATION_REF="a862">
                <ANNOTATION_VALUE>'da nging o bə ngang nga vare nging.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a64" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>'da ngun o ləmləm ngun o do davə.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a65" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>ipəbokbok nandi, (o ava-) io idətərip ava vəda atorotel to ikər mənəmmə ba viuve, mənba ioi, təkənəbət tukip.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>(io itire-) ava itira evi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a872" ANNOTATION_REF="a863">
                <ANNOTATION_VALUE>'ah, nging o mənəbi nə nging?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>ete, 'ava ngang o mənəmu ko ba vokie emu, nga məngəda o amu.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>ete, 'io mərek.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1265" ANNOTATION_REF="a1253">
                <ANNOTATION_VALUE>''da nging o bə ngang nga vare nging."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1266" ANNOTATION_REF="a1254">
                <ANNOTATION_VALUE>"məgət o ngun nganə nging, nəmmə təba ioi."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>məlanga vənan nandi ate, "oʔo kori."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1267" ANNOTATION_REF="a1255">
                <ANNOTATION_VALUE>"nəbət o avar ngang nga vare, to avar ngang kia ngəton təbeme."</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>''ebət o da ngang nga vare təkədo davə.''</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1458" ANNOTATION_REF="a1445">
                <ANNOTATION_VALUE>''da ngun o ləmləm ngun o do davə.''</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>atorotel avar tədor ete, kori, da iep ve vare.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>da ləm bitəm mənəmə ba ioi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>mənəbət, məlanga vuna vənok da vətauk da ikiou.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1459" ANNOTATION_REF="a1446">
                <ANNOTATION_VALUE>vətauk do, (və)tauk do.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>da baterən təpme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>atorotel ivuna inok o itauk mənədo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>da bipərratmi ne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>atorotel o avar tədor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1794" ANNOTATION_REF="a1790">
                <ANNOTATION_VALUE>məlanga avar tədor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1795" ANNOTATION_REF="a1791">
                <ANNOTATION_VALUE>me ippəppormi bərənme me ittauk təgət beme nandi me ipərratmi ne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a78" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>ipərratmi ne nanbət, nanbət, nanbət, me kavar bidəpalət konəng na ikiova.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>idəpaləta do ikiova.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>idəmətiməti təvi da ikiova nandi to ipərratmi ne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>mata atorotel iton do to bə kəbərək to bidəpaləta ikiova.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>iraot pikət ko ne mənba məlanga vənok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>(do)to da iraot pikət ne nandi, məlanga va kuvit idəkəreut do, do</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>do məlanga va kuvit uvi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>me atorotel o inok o uvi, to dənma inok, do.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>io da təməgət, o atorotel imerən təpme təba ioi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>io, evi o məgət o bə ləmləme o bə ba ioi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>tove atorotel imerən təpme o təba ioi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>doto da atorotel imerən təpme mənəmbo, kori itəvat təpme gəmon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>ar nəmmə kup təbe vət to da avar məlanga o bə kori ataup bə mate, ar bə maik moli, ba kəvukəvuk.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>doto da məgət to da ngibərəta evi, o to bə ngibərəte o bə ba ioi, ba tivən nəmə ba viuve, me davə o bə kori.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>tove kəra mənu vəti to ipvi ipərratmi ne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>io məgət, doto da (də-) gəta da nginata go mutəre, o tatamat idə doto bidəngəp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>ba doto məte tatela vətə ba ioi io taton təbeme, io tatate.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>evi o tatəməta vətə mənəmu bəme, o tatəmət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>io tatate, məgət o udu (da mat-) da mat idə o təda mmatme, uvi o avar idəmətor be mmatme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>təda kula kəletuak, me ttak bem tang, pon nogət na men, me be atade o tatate o tapəlok do na vərita avi, tatu vərita do beme, da təda pon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>io doto da ngibone, o ngibəvone nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a99" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>[shell sounds]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a100" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>o do o doto təba atade, o tapəvon nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a101" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>me doto da dəkula kəletuak ba go vakue, o dəpone nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a102" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>[shell sounds]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a103" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>nandi, o do doto təda kula kəletuak, ba pon nogət ne na men, o dəpone nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a104" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>toktok konəng do, nəbət o apir ubət bema mutəre.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_subdivision" PARENT_REF="utterance" PARTICIPANT="TL03" TIER_ID="grammatical_words">
