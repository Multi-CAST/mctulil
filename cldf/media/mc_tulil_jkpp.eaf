            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a102" TIME_SLOT_REF1="ts213" TIME_SLOT_REF2="ts214">
                <ANNOTATION_VALUE>tulil_jkpp_0107</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a103" TIME_SLOT_REF1="ts215" TIME_SLOT_REF2="ts216">
                <ANNOTATION_VALUE>tulil_jkpp_0108</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a104" TIME_SLOT_REF1="ts217" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>tulil_jkpp_0109</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a105" TIME_SLOT_REF1="ts219" TIME_SLOT_REF2="ts220">
                <ANNOTATION_VALUE>tulil_jkpp_0110</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_association" PARENT_REF="utterance_id" PARTICIPANT="TL02" TIER_ID="utterance">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>do ava nganəngar be nga ləm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a224" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>ngang o təmat ngang be təgəta, nereita ko mukəm magərung, me balakətəria, me tuaina, lalənga (avi?).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>laika ngang nanbət, məte laik ngang me pən laik ubət to amənə Siapan o ar kotək idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>nəbət məte laika ngang, təre moli du ləm bəvon avar kəməron, to kori dutuk vəvat, məte kori go idətu udu, tove məgət o bədəməta mətmət mərek me ittu udu, bəvon o kori.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>io laik ngang nanbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>io lətna pən ito aSiapan, me pən ubət o idəmətor mata laləng balakətəria.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>be təm ubət, udu o dutərut, ti uvi to itimiau ba maoka, atepelin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>io du tərut ba beka, terma Vurvəgi, nəbət o təttak be vətbət, to tate, Gakora-vəkatə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>nane Ediat, dumengəp ba vəraia, kori go pəka, vulvət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>io, bərtəm o nane o bingəp, ngang o ar kori go laik ngang, me ngəmmi beme, məte kori go mərek pət, ko go viuva ba umək, me ngang avar kori ngətəm ngane bingəp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>du laika, va itəne Turogua, dərnga avi, to vuila toKidol, me vəbena eNunu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>io, iap o udu-- ləma anudu, ngə mativonnəvənik katum ta, məte toPipite, eLula, Tavinor, Tade, me toMelekit, me ngang, ngang o toktok, bemə ngang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a13">
                <ANNOTATION_VALUE>io nane bingəp, io bənganəkələ?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>kurek ba du ronəng vədəme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>io, betəm ubət nandi ba pən o məte bidəmat məni nidə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>io (dukər-) təkər təpme, təba məngəda, to təttak tate, be Toburut, itəne evi o eto Bior, me burut nəbo Bior, Tulil o kori, Tulil o navodi ba Iaor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>təmərove, me ngang o kori go laik ngang, bətəbokbok tuk ngang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>me bəvon o var dubitəmut, vəvat bətma voin, me avar bokbokpət navodi ba doto məte nane bingəp, o bimətor avar bəba(məto) məngəda to voin, o məngədə təgəta me tattak bema tate urənga o Ravup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>ngang o kori ngətoti urənga avi, io təmume ngang tate-- eVuet imume ngang, məte iep to dava ibakət təvənma nane, dava iep ilukaut bem udu, ngana ngəmativonnəvənik.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>io təmume, me ngang o iaor, doto məte təməngar tate, atiau ba maoka, io atnəvən təba məngəda avi Ravup to məte go to idəngəp, o nanbət to təpma gəri? tate 'tore', io voin ire tabət, ire idabie to abət to vəngəp, da nəmumə təba Ravup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>io ngang avar ngane, me ngəmətor ko nandi, ngang o təpma iaor, ti voin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>io nandi, nəvon, nəvon, nəvon, io təmənu vətbət, ava ngəmu tən təpma iaor, kori ngəppi ngatogən, doto bəngatoti abət to atiau, təpma vənbət, io bəngətən təbe tən to nane, ete voin ubət bidəre idabie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>io ava nga kadre-- nga laika, va dərnge ingəp, ePətətain, me nga laika o toValubən, iap o (va-) vuilvənik o akəra balakətəria, məte eTadar, idəmat məni, toVaruvi, io Martin, me ePatin, ePatin ar idile, me vettie ingəp, nəmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a11373" ANNOTATION_REF="a11371">
                <ANNOTATION_VALUE>io, ngang o məte nandi ba ngang konəng ngəmətor ngana vove ebət, me ngang kori ngətəm ngane nagapon?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>doto bəngətoti e to kəbərək bidəloti do ba ivenang, me ngang konəng ngane, na ePatin to ar idile, io ngəkət məne təkədo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>me vove bimuek na kəbərək lətnidə do, io ingəp təbe ibən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>go itanəng mata nga laika, to vəre mata kəlum nəmə ba Evek, ve kəlubət ito udu nəmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>io eTadar ikərtang, ar kori mərek ne da etaro, ena Tovaruvi, ipəppi, itau itna nga laika nəmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a251" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>iap o təpma kəluma ga vəkən, bəvunə təvat na, təppi nəmmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>io, məte var nane, eVuet, təmanəng, nga vove o bingəp, təkəbənəte, təture, təmue nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>dutəbu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>bəbərtəm o ngang o ve iaor, ti voin, tove ngətən ngane, evi o bə etəba məngəda to voin, dava tare ve idabie nəmumə təba Ravup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>nəbət, ba laləng katum o nga iaor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>io mərek konəng, təmərove, təmərove, tabət kori təttən kup, ngang o ve ngəmu ngattən be voin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>io, vareot vəvat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>məte bəbavonbə konəng, be lalənga apmə, amumə, məte təgəta me nereita ko mukəm magərung, me libəti me nereita ko mukəm, laləng abət, ava nga kəvova, va itəne Tagong, kori go Tagong amumə, dərnga, Tagong, nga kəvova, to ba temengəp ko nəpbo ba Malobanga.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a259" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>udu langmudu da dəta bəli, io duppi, dumənəmumə ba tipur, nəbo, tattak be tipur ubət na Gəngənit me Gaepka me Silivit, io ngang avar kəra mamani von da nga nəta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>io, duppi, duba arot, io duvənma bəlia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>me doto məte bə be lalənga abət, io durea, tove ba tipur o kori go mətmət, avar udu dure ləmat, me dure apərəgum me ləvək, duppi, duna avar nga kəvop təgəta va itəne toKabang, avi (a-) atuka kəvop.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>io, ngun ngana nga kəvova avi, ngun o ngunuppi konəng, me iap to məte təda manənga bəli o toKabang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>lətnudu nəbo, dumengəp, dukəbənəta kəlake na mərəm, dumengəp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>lətnudu o duvən təvi na bəli, bəli vakue.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>təkənəbo, məna dutəte du-vəraie ar nəbət ko be vətivon nonbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>mərek.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>mənibərui, avi toKabang bəvətuk mata kəvop, me udu o bədumətor ba məngəda ba tipure ebət to dukəbənəta du kəlake da dətor me dətela avut, vətə, io təkənəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>iap o vəkərtang mənibərui, io vəngar tuk ngang ate, 'nəbo ba məngəda abo, Gaepka ato mərubət, ləmat mukəm ipbo.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>me vukin mat ngang ate, 'ngivəde, da ngitulai udu nəbo, me dəton da go ləmat nəbo, io ngire gətip nuvəde da təkədo, ba məngədə ləma avi to dukəbənəta.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>dumənan, ngətulai ta, ava dutər kona bəli laika, ar mənibərui, vanənga ana kəvop, kəvop bidəmata, io verən nandi nəmumə, təbəro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>duvən ma, dutət ləm na, təmmana idutia, me kəbərke, o duvune, me idutia o təkəbənəta, ava tətukir na nəmu tətingit na kəbit loka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>io ngunumatər, nandi, nga kəvova vəngar ate, 'nga laika, binəmənana bokbok uvə mənbəvon to laikta təbokbok tuk udu, be Ravup, o kəra avi.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>ngang ngəmatər, bə ngunutəmuləna bokbok bəbe vəti tove mən bəvon dumənamənana uvi to bəngəməngar bem.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>io ngang pəka da ngumi, me (tə-)mənəmumə ngəməngar ngane, 'ngang o iaor, o do bəpəka da ngumi,' ngane, 'o, ar ngəton me ngəmatər bərənma ioivəp, ko go kabar, məte nəmu konəng to kəlake nəmu be təmulən, ioi ko bəp navodi.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>ngane, 'o! laikta o təpma kəmak.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>do o venang to bəvon o tate voin itata molimolia io atanəng navodi o təkənəmu me tor me ve kənakənaru me gu venang kup nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>io, pət məna bitəmut, mərot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>io, duliu, me bəngəbokbok nandi, me nane emu muitəm ne, o bingəp, me do məte ve ngastori-- io nganobokbok navodi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>io duliu, o ngəməngar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>io bəmənəbət o ngang o bəngəppi kup, bəvəda vətak to tate vəvata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>Piupiu, (ava-) avar ngamənəmumə bərodəma, avi o tate avar vəppən, me tate avar məngəda to voin me vəvata, va itəne Piupiu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>udu katum konəng do Tulil o dutəma təbe Bior mənbe Nəpəpər.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>ngang ngəmunman.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>ngəməngar tuka nga kəvop mukəm magərung, toLait, təgəta, toUvi, ar kori vəngəp, ar apmə konəng, toPitdiat, ar kori vəngəp, ar apmə konəng, Atven o nga makuta, ar apmə konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>udu da amoli neireita ko mukəm, udu to da duppi nəmumə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>ngəməngar tuk ta ngane, 'dəppi, dətela go məte uvi navodi, apurpura da dəkən nəmə, nəmə to apəlnə lotu.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>io ngəppi ngane, 'tatobokbok tate, məngədə məreka me amesin etərat, io da ta go venang mənəbət tove mənba vəvata da tə pədəm.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>duppi nəmumə, duppi ba venang, kətəbukbuke, toktoka kilap do.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>io udu o duppi nəmmə, kərvuk na ngamərkəma nəmmə, toktoka kilap do.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a63">
                <ANNOTATION_VALUE>avar nəvon, do va ngateka navodi, ava ngateka navodi, ava nandi, ava mənəbət o navodi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>duvi, duvi, duvi, ngane, [gesture: hands on lips], ngəmu ngənok navodi, ngane, da kori dəngar tove iaor ti vəvata atata du kən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>ngang o kori ngəbitəmut bətma uvi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>ngang nga nogət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>duppi nandi, nəmbo, nəmbo, me ava tavə (gesture) vəbuk konə ngang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>atir ngang ate, (gesture), io ngane, (gesture)</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>io kori dubokbok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>kuteta katum konəbət, me abət ar mən bəvon be laikta o təppi nəmə ga Toviloga, nəbət o laikta təppi ba tuka abət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>me do kori moli, kori moli da təppi do tove vəvata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>io va təkənəbo ga EKaevoi, io təppi nandi me vəvat (gesture).</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>io uvi to nganobokbok bem o mədərəp konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>io da ngəkərtang da ngaton.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>təre moli, iap avar vətor, me kori ngətoti go təreuk, o bərivu konənga vəkərtang, me itnave məte pələpələp me kərukərung, me bərivua vəvenang nudu, me kəvənave, dumerən, da bədəvuna dukatə navodi, me nandi me nəbo duppi o idəkatə təgəvəti, ngang nga təgəvəti o ava avə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>bə iaor udu, tove pələpələp, me kərukərung.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>dutelə, kori, kori dutoti go təreuk, me təre moli dutoti konəng na uvi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>dumerən, ava təkənəmə ga Laikpoi, idəna voibət piupiu, ioivoi idə itəne me ar təbe vəvata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>vənu məreka, vənu laika, idətəp mat udu, dumengəp nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>io kori go kəvənave nəmə, me avar kəvənave o do konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>io idətəp mata du məl, me ngitəma dumətor ba tipur, udu adəpen ko bətəng, me kori go atərautet, me kori nanbət, me atingilit tove dumu idə ve məl ubət to kəvərta to da dumu idə bətəpmətang tove ti kənunət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>o, ah, muləgəp nəvon, idətəp mat udu, ngane, 'a, nagapon?' ngətira, tavə bimanmanin na ta kəlvənik, me bəkori mərek bətmə ta tove uvi bələtnidə bətmudu nəbo ba tipur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>ngəməngar tuk ta ngane, 'doto inəbitəmut moli bətma Laika, o inəvəde, me iap to kori vəbitəmut bətma Laika o vətor.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>dukərtang, duppi ava nəmbo, muləgəp nəvon, o duppi nandi, ko go kəvənave, von konəng, von konəng, von konəng, ar təbe vət to ngang ngəmu ngə katə mənu nang laika nəmə ba venang, kori dutoti vətə, me dutoti kona lukluka be nəmə to idəppi idəppi navodi, dutoti ko na məlivuve, me vətə o kori dutoti idə, məte amarek, kətiləm, kəgorə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>io ngəmu ngə katə mənu kəbəram laika, kəbərama abət o vət me vətor navodi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>kavar ngane, muləgəp nəvon dava ngəmu ngə katə nəbo be vət ko to bəngəmu ngə katə be maməni von, ava pələp, ava ite kərung, ava pələp, ava kərung, ava pələp, ava kərung.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>iap to apədəm ava anogət, me va ngang to nga nogət o bə nga pədəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>avə atnəvən o dərkata to udu o iaor (dune, do--), dumerən, dumerən, dumerən, ar təkənəmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>(du-) duleir moli to dukuva dukatə mənba kətəbukbuke kati avar pəka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>nəbo kətəbukbuk katum konənge me ioi kurek ubət to idəmorən, ulang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>io təkənəmə, ava məgət tang konəng, vənua vətor, kori go kəvənave, nəmə ga Laikpoi idəna Piupiu, ava dumətor.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>vareot, vareot, vareot, vareot, idətəp mat udu tove ko go kəvənave nəmə, mənəbo na iləma, bəvəppi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>ta tate, 'bəkori dəppi', ngane, 'o, ngalar bemə nging, muləgəp magəvon, dava dumbo, doto bəmuləgəp magəvon o toktok, da bədəliu.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>kori go varvar ta təda pi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>ngəmatər, ngane, 'ngang o langmə ngang da ava dumbo.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>toLait vəngar ate, 'nga laika, do o dumbo, me avi apəvən ko nudu, io ti bəgəta atəup.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>ngang ngane, 'nging o ngibitəmut bətma guria? idabi mədəne ba idabi vore?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>io ava vənan.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>ngane, 'ngang langmə ngang dava ngətinak ngən, məle vəvat moli nudu.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a12314" ANNOTATION_REF="a12312">
                <ANNOTATION_VALUE>dumət mata məna ve lokmət ubət to bə lokmət idə ba du kabak, me du mətmət to məte apəvərai, atopiokpətəng to du venang na ləmatpəlak, o məna kəvənave ivat idə io malot kup nidə, o dumət mat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>io, vənua, vareot udu io akəra va dukərtang, (nambə tri taim,) muləgəp magəvon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>io, lətnudu nəbo, ava məgəttang konəng, ava ngəmu ngə katə mənu kəbərama, ava pələp o bə [INAUDIBLE] vəvat na, məte doto təvuna venang nandi, aka vələ to təvume vələ ba du təmək, o von to da var bəkəvənave me gəri me bərivua bə dame ba kət məna gəta da apuna təkənəmu o von to da var bədumerən bərivua kəbəkokup, to bəkori dutəm me bəvula.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>io, do toktok na vətbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>io, duliu, o bədumətor vəvavon konəng, nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>nga bokbok uvi to ngəbokbok be vətbət to binəmənan, mərek.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
