    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_association" PARENT_REF="utterance_id" PARTICIPANT="TL05" TIER_ID="utterance">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a66" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>do da nganəngar be amolia ana va dərnge.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a67" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>ngang e-venang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a68" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>do nganəngar be amolia ana vadərnge to ve dərnga o molimolia be gup, gup mata bəli kuobər ba tipur, to vətəma gup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a69" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>io, vənu tarə, o vəppi təba tipur vənggup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1713" ANNOTATION_REF="a1711">
                <ANNOTATION_VALUE>io vəre bəli tuka va dərnge ena ipvila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a70" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>io təmət idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a71" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>iova vəti təgəvon, o va vəppi moli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1745" ANNOTATION_REF="a1743">
                <ANNOTATION_VALUE>idila bidəmat na da ana vattia təba tipur, dava ip katum itəba tipur, ikgup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a72" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>io mata avi vattia ana.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a73" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>io ipəppi təba tipur itna kəvop da təgup.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a74" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>io mata avi laika o kori vənma go bəlia, io bəvən ko mata avi idila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a75" ANNOTATION_REF="a10">
                <ANNOTATION_VALUE>io vərea.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1814" ANNOTATION_REF="a1806">
                <ANNOTATION_VALUE>io vərai mata ba tipur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a76" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>vəmana vəlata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1815" ANNOTATION_REF="a1807">
                <ANNOTATION_VALUE>vəlata o vətuka kəvop na, me vəkatə me vənok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1816" ANNOTATION_REF="a1808">
                <ANNOTATION_VALUE>me bəvəre konəng na va mədərve.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a77" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>vorən mate da vəre təba məngəda tuka va dərnge.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2753" ANNOTATION_REF="a2749">
                <ANNOTATION_VALUE>me iap vət mat bema.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2946" ANNOTATION_REF="a2943">
                <ANNOTATION_VALUE>io vəppi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2947" ANNOTATION_REF="a2944">
                <ANNOTATION_VALUE>bəvəliu təba məngəda təpma gativoi voivi na idila avi va vərete, to vəliu təpme da bəmeva va dərnge ba məngəda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a79" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>io bələtna ba məngəda təpma kəripe evi na molimolia avi va vərete, idila, va vərete da vəre meva va dərnge ba məngəda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a80" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>io, lətna təpme, gativoi voivi, io vətəvat nə voi ga va dərnge imi, da va dərnge betət poi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a81" ANNOTATION_REF="a16">
                <ANNOTATION_VALUE>io, mata evi va dərnge biməti da gativoi voivi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3501" ANNOTATION_REF="a3499">
                <ANNOTATION_VALUE>io da bimmət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1817" ANNOTATION_REF="a1809">
                <ANNOTATION_VALUE>bimmət navodi io bitira.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3472" ANNOTATION_REF="a3470">
                <ANNOTATION_VALUE>bitira ete, 'me nging o ngunu vila o babi?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2736" ANNOTATION_REF="a2734">
                <ANNOTATION_VALUE>'ngunu vila o babi?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a82" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>avi məna kori vəbokbok, me məna kori vəkiata evi va dərnge evi ikən to itira, ibokbok nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a83" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>ava itir moli, ete, 'məie ngunu vila babi?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a84" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>io vəngar ko tuke ate, 'me gəri ubət to nginəmət?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a2754" ANNOTATION_REF="a2750">
                <ANNOTATION_VALUE>'gəri ubət to nginəmət?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a85" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>io evi o bəttəp konəng ne, me bəkori go bokbok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1827" ANNOTATION_REF="a1825">
                <ANNOTATION_VALUE>me bəttəp konəng ne me bidənən ne təpma ve kədikəne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3775" ANNOTATION_REF="a3771">
                <ANNOTATION_VALUE>da vəda avi da epən ma, avi ittia.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3776" ANNOTATION_REF="a3772">
                <ANNOTATION_VALUE>da epən ma nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1830" ANNOTATION_REF="a1828">
                <ANNOTATION_VALUE>bəkori iap vəbokbok, (? be ibən) məte bəvengəp</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a86" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>bəvengəp nəbət ga imi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1834" ANNOTATION_REF="a1832">
                <ANNOTATION_VALUE>me iep o bebət konəng to bidənən ne da etatme da gəri təpma avi ittia, to bəkədikəne ba ironəng bema ip vila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a87" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>nanbət konəng iap o bəvengəp, vengəp mormor to dəva me popou və katə mənba tipur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a88" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>vengəp nanbət to bəva vənevən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3899" ANNOTATION_REF="a3897">
                <ANNOTATION_VALUE>me evi o ittən ko da epən ma avi bema avi idila.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a89" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>ittən konəng da go təreuk da etatme da gəri təpma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a90" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>kavar von to itən mat ete, 'do ngatadəma turin.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a91" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>io itadəma turin nəbət terma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3610" ANNOTATION_REF="a3608">
                <ANNOTATION_VALUE>me imu tivəne nəmu ba turin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a92" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>io itadəma turin bətəpma tivənbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3944" ANNOTATION_REF="a3942">
                <ANNOTATION_VALUE>tivəne təgəte.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a93" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>mata avi o bəvengəp mormor, bəmormora ba vəkəlom nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a94" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>ar von to bə lem tənin na tivəne evi nəmu ba turin o kavar imata doeda ituk mən mata tivəne evi nəmu ba turin o ittəng ne nəbo məta, me ivətuk nəmə gəma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a95" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>me vəttəvəkup me iep o ikəng təgət na doeda nəbo məta təpma tivən loke evi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4210" ANNOTATION_REF="a4208">
                <ANNOTATION_VALUE>da irəgən məta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1842" ANNOTATION_REF="a1835">
                <ANNOTATION_VALUE>io kori vəpuna va vənea, me idənənna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a3637" ANNOTATION_REF="a3635">
                <ANNOTATION_VALUE>dame da apəlut, me kori, avar ivətuk moli nəmə gəma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a96" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>io nəbət kori me bə toktoke iap ar vəngəp bətma tivən loke evi to ittəng ne məta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1843" ANNOTATION_REF="a1836">
                <ANNOTATION_VALUE>ar vəngəp io kəra imana inok məgema tivəne nəbo məta, me ikatə nəmə to ivətuk vəkai na nəmə gəma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a97" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>nəbət konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4025" ANNOTATION_REF="a4021">
                <ANNOTATION_VALUE>ngang e-venang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a4026" ANNOTATION_REF="a4022">
                <ANNOTATION_VALUE>ngang Sisili eViru.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1844" ANNOTATION_REF="a1837">
                <ANNOTATION_VALUE>ngənəngar be uvi, apir uvi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a98" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>ubət konəng me toktok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
