    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_association" PARENT_REF="utterance" PARTICIPANT="TL05" TIER_ID="utterance_translation">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7948" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>Now I'm going to tell about a man and his wife.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7949" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>My name is Miss something.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7950" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>I'm going to tell about a man and his wife, whose husband is a person of hunting, hunting for wild pigs in the bush, because he knew hunting.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7951" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>then, many times, he went to the bush, he hunted.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7952" ANNOTATION_REF="a1713">
                <ANNOTATION_VALUE>Then he carried pigs to his wife and their son.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7953" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>then they ate them.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a7954" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>then one day, he went again.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
