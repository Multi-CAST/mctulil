    </TIER>
    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_association" PARENT_REF="utterance_id" PARTICIPANT="TL01" TIER_ID="utterance">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a211" ANNOTATION_REF="a1">
                <ANNOTATION_VALUE>ngang o ava nga itəne moli Augustine Rickie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a212" ANNOTATION_REF="a2">
                <ANNOTATION_VALUE>me do ava ngəmətor da nganume bema apir, me kori go apir, apir təre moli to avar ngang ngəmatme dəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a213" ANNOTATION_REF="a3">
                <ANNOTATION_VALUE>apir idil uvi o bema kəvənave to ngəmatme da kəvənave ngana nga məlna.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a214" ANNOTATION_REF="a89">
                <ANNOTATION_VALUE>nga məlna va itəne Fidelis Vəninar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a215" ANNOTATION_REF="a4">
                <ANNOTATION_VALUE>be lalənga 1994, o ngang o nga-- ngana nga məlna avi o, ngunu kərtang məndo, təkənəmumə da ngunutteltel mat nəmumə be west coast be central new ireland ba məngəda to tattak bema tate, be Lambu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a216" ANNOTATION_REF="a5">
                <ANNOTATION_VALUE>doto dumətor be Lambu o udu dummengə (bərodəm--) ba məngədə kəledaka ato tabu, nga vadoke Senta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a217" ANNOTATION_REF="a6">
                <ANNOTATION_VALUE>iap to ativi nogət nudu be atade, iap va dərnge.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a218" ANNOTATION_REF="a7">
                <ANNOTATION_VALUE>dumətor nəbət ba ta ta məngəda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a219" ANNOTATION_REF="a8">
                <ANNOTATION_VALUE>me doto dumətor nəbət to lətnudu təkənəmu ba məngəda abət, me abət o vənu laika bəvəppən ma məngəda abət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a220" ANNOTATION_REF="a9">
                <ANNOTATION_VALUE>vənua bəvətton vareot</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a221" ANNOTATION_REF="a90">
                <ANNOTATION_VALUE>me tərevənik o bidəmmang idə, tipur me nangə o bidəmmang idə. məgəte ubət bu avar bə idəmiav idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a222" ANNOTATION_REF="a11">
                <ANNOTATION_VALUE>mərəm ga tipur idənung, ga nangə idə nung ubo o bə kərekərerət idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a223" ANNOTATION_REF="a12">
                <ANNOTATION_VALUE>me doto da dutteltel ba tipur, o idəttər udu vədəma turin to bələlət moli konəng na turin.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a15385" ANNOTATION_REF="a15383">
                <ANNOTATION_VALUE>nəbət ga tipur idənung o bələt kona go turin o bitamang lau nəpbo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a225" ANNOTATION_REF="a14">
                <ANNOTATION_VALUE>io nangə to-- nangə laik moli vənik to məgəte vənik uvi do batma məngəda, ubət ar bəkərekərerət idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a226" ANNOTATION_REF="a15">
                <ANNOTATION_VALUE>me ioiviok o bidəttəviok məgəte məndo ba Mətəvut, məgəte ar bətoktok nəmə to Tovue atemengəp nəmə təma Dava vədo. təma tuk laika vədo təkənəmumə, (ba) be vət to molimolita takəkərəbut.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a227" ANNOTATION_REF="a17">
                <ANNOTATION_VALUE>ioiviok o bidəttə viok o məte toktok nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a228" ANNOTATION_REF="a18">
                <ANNOTATION_VALUE>doto dumətomətor nəbət (me--) ba maoka abət, me udu katum konəng o duna molimolita mənəbət to duttela ioi da dutturən me duttela ioi təda tangədə, me duttela ioi da təda nakən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a229" ANNOTATION_REF="a19">
                <ANNOTATION_VALUE>dummata tuk laik nəmbo me duppi ba ioiviok nəmbo, vətak to bidəttəp da duttəra vət to ioivoi ar itamanəng konəng io dəkatə mat nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a230" ANNOTATION_REF="a20">
                <ANNOTATION_VALUE>io nəbo ava dəlliu nəmmə mənu tivən ba ioiviok, me avar mənu tivən ba tuk, nəmumə o avar məngəda aumu o tivən katum konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a231" ANNOTATION_REF="a21">
                <ANNOTATION_VALUE>doto maoka abət to dumətor nanbət me dutton dune, 'tabo, udu o məngəda avi o ngane mərek konəng da ka go vətivon o məngəda avi o lətna turin do bərodəma məngəda avi, tove turin o bə lələtnidə nəpbo mənu bərən.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a232" ANNOTATION_REF="a91">
                <ANNOTATION_VALUE>bidəmmanga kəguing.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a233" ANNOTATION_REF="a22">
                <ANNOTATION_VALUE>kəguing o tipur idə to ittuk məgəte kori-- kori mərek da go molimolia da api.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a234" ANNOTATION_REF="a92">
                <ANNOTATION_VALUE>me ubət o idəmmang idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a235" ANNOTATION_REF="a23">
                <ANNOTATION_VALUE>me balut, tul ubət o mən davə. o ubət o bidətturən o bənəmumə be ioiviok bəro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a236" ANNOTATION_REF="a24">
                <ANNOTATION_VALUE>idəmmənəvən mənəmbo da bidətturən nəmu bəro ba ioi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a237" ANNOTATION_REF="a25">
                <ANNOTATION_VALUE>me tul o avar bidətturən nəmu bəro ba ioi, to lovakəti to vənua ba maoka abət o laik moli.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a238" ANNOTATION_REF="a26">
                <ANNOTATION_VALUE>be vəti təgəvon o nga məlna Fidelis Vəninar vəngar tuk ngang, ate, 'ngali, do vənua avi o vatər tədor.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a239" ANNOTATION_REF="a27">
                <ANNOTATION_VALUE>'me ngang o ngattən da məna ngu-- ngukəbənəta go tərea.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a240" ANNOTATION_REF="a28">
                <ANNOTATION_VALUE>io ngang ngətira ngane, 'gəri idə? gu tərea abət to ngiməngar bema?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a241" ANNOTATION_REF="a29">
                <ANNOTATION_VALUE>io vəngar tuk ngang ate, ava məna ngular ko be vənua avi to ngukəbənəta go kəvənave da məna kəvənave etnəvən konəng.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a242" ANNOTATION_REF="a30">
                <ANNOTATION_VALUE>'da epata tərevənik.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a243" ANNOTATION_REF="a31">
                <ANNOTATION_VALUE>io ngang avar kori ngəvul avar ngəbitəmut konəng bətma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a244" ANNOTATION_REF="a32">
                <ANNOTATION_VALUE>ngane, 'io ne udu?'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a245" ANNOTATION_REF="a33">
                <ANNOTATION_VALUE>io vəngar tuk ngang ate, do ngikərtang məndo, nginat mata nanga avi me vətak be nangə idə itən, me kori ngatak bem.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a246" ANNOTATION_REF="a93">
                <ANNOTATION_VALUE>vətak be nanga avi, me avi, me avi, me avi, me avi, me avi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a247" ANNOTATION_REF="a34">
                <ANNOTATION_VALUE>'nginat katum konəng mat idə me ngang o ngəmətor konəng,' tove iap o tukəre be vəkatə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a248" ANNOTATION_REF="a35">
                <ANNOTATION_VALUE>io, mata ngang o avar ngəmatme da vətbət to iap vəngar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a249" ANNOTATION_REF="a36">
                <ANNOTATION_VALUE>ngəmənan bətma, ngəppi, nəmbo, ngəmat mata nangə ubət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a250" ANNOTATION_REF="a37">
                <ANNOTATION_VALUE>ngəmat mat idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a251" ANNOTATION_REF="a38">
                <ANNOTATION_VALUE>io, təkənəmə, ngətərut təvi konəng nidə, me lətnə ngang nəmumə ba məngəda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a252" ANNOTATION_REF="a39">
                <ANNOTATION_VALUE>lətnə ngang nəmumə, vətir ngang ate, go tərea avə o bə nagapon?</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a253" ANNOTATION_REF="a40">
                <ANNOTATION_VALUE>ngane, bənəvibo, to bənga-- bəngətərut təvat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a254" ANNOTATION_REF="a41">
                <ANNOTATION_VALUE>ate, io bər ngun.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a255" ANNOTATION_REF="a42">
                <ANNOTATION_VALUE>ngang nga tangədi konəng, təkənəpbo konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a256" ANNOTATION_REF="a43">
                <ANNOTATION_VALUE>io, vəppi təkənəbo, o vətor gəvənma ngari laika</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a257" ANNOTATION_REF="a94">
                <ANNOTATION_VALUE>me vəngar ate, ngikutəng mata go rovənəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a258" ANNOTATION_REF="a44">
                <ANNOTATION_VALUE>vənor mənə ngang, ngəppi təbe rovətə, ngəkutəng mata rovənəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a259" ANNOTATION_REF="a45">
                <ANNOTATION_VALUE>io mata bəngəliu təpma rovənəm nandi io bəngunukəbənət idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a260" ANNOTATION_REF="a46">
                <ANNOTATION_VALUE>ngunukəbənət idə io bəngunumu idə nəmu ba rovənəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a261" ANNOTATION_REF="a47">
                <ANNOTATION_VALUE>io, vənor mənə ngang ngana Langer, David Langer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a262" ANNOTATION_REF="a48">
                <ANNOTATION_VALUE>ate, do ikərtang məndo, itata ioivoi nandi nəmbo nəmbo nəmbo nəmbo, me ikəkədəp təvi ba ioivoi vədəma nanga to va itəne akidəkidam.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a263" ANNOTATION_REF="a49">
                <ANNOTATION_VALUE>go tərea avi to va itəne akidəkidam avi attuk məgəte apurpur.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a264" ANNOTATION_REF="a50">
                <ANNOTATION_VALUE>me kori attuk nəmbo kup me attuk o da toktok konəng do.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a265" ANNOTATION_REF="a51">
                <ANNOTATION_VALUE>io, vəngar tuk ngang ate, 'abət to nginat mata va uviok.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a266" ANNOTATION_REF="a52">
                <ANNOTATION_VALUE>io, doto təkənəbo gəvənma urənga o ngibinga ba nginok, nginanga ba nginok o ngibəvur toktok na təkənəbo mənu umu ba rovənəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a267" ANNOTATION_REF="a53">
                <ANNOTATION_VALUE>io ngitəvat na nəbo, ngirəgən tiktik təma, io ngibəve rovənəm nəbo, təgəvənma urənga.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a268" ANNOTATION_REF="a54">
                <ANNOTATION_VALUE>avar ngəvi mənu vətbət to iap vəngar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a269" ANNOTATION_REF="a55">
                <ANNOTATION_VALUE>vume mat ngang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a270" ANNOTATION_REF="a56">
                <ANNOTATION_VALUE>ngəppi nəmbo, ngunuppi nəmbo, avar ngəmatme dəm məte doto vəngar.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a271" ANNOTATION_REF="a57">
                <ANNOTATION_VALUE>io ar lətnə ngun be urənga, be urənga abət o kəbitə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a272" ANNOTATION_REF="a58">
                <ANNOTATION_VALUE>idə-- idərrap bətəpma urənga nəmmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a273" ANNOTATION_REF="a59">
                <ANNOTATION_VALUE>io ngang o ngətar kuvit konəng bətəpma urənga nəmbo, nəmbo, nəmbo, nəmbo təpma kəbite da ngəppe vəkai təvat na rovənəm vənəvi təpma kəvənave nəmu, nəbət to bimatme dəm tang da bəkəvənave nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a274" ANNOTATION_REF="a60">
                <ANNOTATION_VALUE>be von to bəngəppur təkənəbo, təbe rovənəm idəkən, na nanga avi to ngəttak to-- ngəttak toktok bema me idə kori ngatak bem.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a275" ANNOTATION_REF="a61">
                <ANNOTATION_VALUE>doto bəngəppur təbe vəkən nanbət, io ngərəgən tiktik təma, o nəbo bəkəvənave nəbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a276" ANNOTATION_REF="a62">
                <ANNOTATION_VALUE>bəngəkəbənət katum na kəvənave. da kəvənave o da bə molimolie.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a277" ANNOTATION_REF="a64">
                <ANNOTATION_VALUE>me iap o vətor təgət nəmə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a278" ANNOTATION_REF="a65">
                <ANNOTATION_VALUE>me vətton təkənəbo be utəme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a279" ANNOTATION_REF="a66">
                <ANNOTATION_VALUE>doto vətton təkənəbo be utəme, o vətoti kəmurvən to vən idə-- vən idəvi, io bərivua ava vəppət də vən nəbo be utəme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a280" ANNOTATION_REF="a67">
                <ANNOTATION_VALUE>kavar vəkərtang o vəppi nəmumə təba məngəda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a281" ANNOTATION_REF="a68">
                <ANNOTATION_VALUE>banogət ngun ngana Langer.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a282" ANNOTATION_REF="a69">
                <ANNOTATION_VALUE>ngunu o ngunukəbənət təvat na evi to ngunuppe təvat ne nəbo gəvənma urənga, da bəngunuliu təba məngəda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a283" ANNOTATION_REF="a70">
                <ANNOTATION_VALUE>ar ngunuppi konəng mənəmbo ba ioivoi be vət to bidəttəva ioivoi, me bəmiləmiləng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a284" ANNOTATION_REF="a71">
                <ANNOTATION_VALUE>to kəmurvən nədi to idəvvet nəmbo me bərivua vəppət də vən o vəre vən nandi nəmmə, nəmmə, nəmmə, io vən idəməkən tang nəmə be vət to vənua atəmənəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a285" ANNOTATION_REF="a72">
                <ANNOTATION_VALUE>vən idəməkən mat tang nəbət, o bərivua vəbənakən tang, bəkori vəmmip mənəvimə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a286" ANNOTATION_REF="a73">
                <ANNOTATION_VALUE>me bərivua bə vəmmip mənəvimə to vənua akəngəp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a287" ANNOTATION_REF="a95">
                <ANNOTATION_VALUE>me (bəkori--) bərivua bəkori vəmmip məndo be vət to vənua akəkər.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a288" ANNOTATION_REF="a74">
                <ANNOTATION_VALUE>nəbət o məgəte, doto bərivua bəvəbakət, o nəbət o (bəvə--) məgəte kəvənave betamatme nanbət, to (və--) bərivua bəvəbakət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a289" ANNOTATION_REF="a76">
                <ANNOTATION_VALUE>bəkori ativi məte do məgət, to bərivua ativi mənəpmə to vənua akəkər.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a290" ANNOTATION_REF="a77">
                <ANNOTATION_VALUE>me bərivua bəvəbakət, bəvəppi mənəvimə to vənua atəmənəvən, o nəbət o udu o bədubitəmut dune, kəvənave betnəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a291" ANNOTATION_REF="a78">
                <ANNOTATION_VALUE>doto ngunuppi da ngunumata ioivoi da bəngunuliu təkənəmə ba məngəda, me bəmiləmiləng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a292" ANNOTATION_REF="a79">
                <ANNOTATION_VALUE>me iep akəra ebət mənəmmə to kəra irut təvi məgəte nəbət to vədau ubət to vədau idəmatər nanbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a293" ANNOTATION_REF="a80">
                <ANNOTATION_VALUE>io nəbət o bərivua bəvərrut təvi konəng nandi, nandi, nandi, me iep o bikpət bərodəme me ianem (bidə--) bələlət nidə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a294" ANNOTATION_REF="a81">
                <ANNOTATION_VALUE>bə pələpələp nəmu bərodəme, me i-- i-- ipperən təvi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a295" ANNOTATION_REF="a82">
                <ANNOTATION_VALUE>von von von von von von von konəng, kavar (i--) imorən be vənua umi nandi o bəllətna tərotərot laik, udək laik bidəmmənəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a296" ANNOTATION_REF="a83">
                <ANNOTATION_VALUE>bidəmmənəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a297" ANNOTATION_REF="a84">
                <ANNOTATION_VALUE>doto da imatər mata mənəvən o immənəvən me immənəvən me immənəvən immənəvən mənəbət to vənua vətor ar nəmbo moli ba dudo, nəmumə nəmumə nəmumə nəmumə, ar vərdət be dumi to vula ar vəkabet be dumi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a298" ANNOTATION_REF="a85">
                <ANNOTATION_VALUE>me iep o immənəvən konəng immənəvən konəng me kəvənau laik moli e, to immənəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a299" ANNOTATION_REF="a86">
                <ANNOTATION_VALUE>toktok mə-- mədərəp na vula o təp ne.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a300" ANNOTATION_REF="a87">
                <ANNOTATION_VALUE>doto bətəp ne nanbət, o bə kori immənəvən vəvat me bə miləmiləng konəng, tiritirit konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a301" ANNOTATION_REF="a88">
                <ANNOTATION_VALUE>kəvənave imatər mata atade muitəm. to kori immənəvən pikət, me miləmiləng konəng, miləmiləng konəng, miləmiləng konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a302" ANNOTATION_REF="a96">
                <ANNOTATION_VALUE>me imətor mata atade muitəm, me nangə o bidəbbakət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a303" ANNOTATION_REF="a97">
                <ANNOTATION_VALUE>bələllətna kəvəlok ba nangə idəkən, idə to idəmiav idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a304" ANNOTATION_REF="a98">
                <ANNOTATION_VALUE>me tipur ava ləllətna kəvəlok, ava idəttuk.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a305" ANNOTATION_REF="a99">
                <ANNOTATION_VALUE>io, bətəp ne, təvənma atade muitəm o bətəp na kəvənave.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a306" ANNOTATION_REF="a100">
                <ANNOTATION_VALUE>bimmənəvən konəng təbərtəm, do to təbərtəm o nəbət ava etnəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a307" ANNOTATION_REF="a101">
                <ANNOTATION_VALUE>io nəvon o go vəti vələgəp o ava vənua, ava go vətivon o ava etnəvən bətəbərtəm konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a308" ANNOTATION_REF="a102">
                <ANNOTATION_VALUE>doto vənua bəvətton təvi ava nanbət, io, vəti təgəvon, o ToVəvəi, David, va mukəm (iap to vəbena) Senta ve ti təgəta, ana va dərnge, ikkərtang, da ipəppətə ba ioivoi ioibət, to udu dumu kəvənave nəbo. ga urənga və nung.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a309" ANNOTATION_REF="a103">
                <ANNOTATION_VALUE>me ip o kori ittəm ite, kəvənave ebo.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a310" ANNOTATION_REF="a104">
                <ANNOTATION_VALUE>ipəppətə təvi konəng na ioivoi nəmbo nəmbo nəmbo, io, tove, be von to kəvənave immənəvən o iləma vanəng ba ioivoi, io vat təvi na rovənəm o (vətəvat--) vu vənəm nəmumə ba tənovən nəmu ba ioivoi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a311" ANNOTATION_REF="a105">
                <ANNOTATION_VALUE>io doto ip ipmana tənovən, o itton təbema rovənəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a312" ANNOTATION_REF="a106">
                <ANNOTATION_VALUE>itton təbe vənəm nandi io ip o ittən ite, go təreuk to kurek do təda dok, leir na molimolita da takəngəp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a313" ANNOTATION_REF="a107">
                <ANNOTATION_VALUE>io mata molimolia avi ana va dərnge ipmata rovənəm, io ipvalət pənəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a314" ANNOTATION_REF="a108">
                <ANNOTATION_VALUE>doto ipvalət pənəm, o tərona to kəlon, vəvat moli, təron vəvata.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a315" ANNOTATION_REF="a109">
                <ANNOTATION_VALUE>me kənogəle ubət, vərən, o (l)lətnidə təkənəbət to ar vuvən idə nəmu bema.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a316" ANNOTATION_REF="a110">
                <ANNOTATION_VALUE>tərevənik to ve bə kəlon idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a317" ANNOTATION_REF="a111">
                <ANNOTATION_VALUE>io doto ikvalət pənəm təkənəmu da ava ittur mənidə da təkənəmu ba ioi nandi, akəra ava kəvənau kəmərone ava imənəvən.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a318" ANNOTATION_REF="a112">
                <ANNOTATION_VALUE>bəkəvənau bəlaik moli e to imənəvən nandi ileir na logəvətak vətak to təmu vətak bərənma tuk laik da vəduvədur idəmmanəng o (i--) kəvənave ippət dəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a319" ANNOTATION_REF="a113">
                <ANNOTATION_VALUE>da logəvətak o bə-- logə balakətəria vətak bə ioi balakətəria viok o kəvənave ileir nidə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a320" ANNOTATION_REF="a114">
                <ANNOTATION_VALUE>doto lətnip təkənəmə ba məngəda, o bətəmmatme da bokbok.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a321" ANNOTATION_REF="a115">
                <ANNOTATION_VALUE>tate, udu lokpənik məndo be Rəbəul o dukəbənəta go təre kureka nəbo da təda leir na molimolita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a322" ANNOTATION_REF="a116">
                <ANNOTATION_VALUE>io doto ToVəvəi, Katiket, və-- vata bokbok, o ana va dərnge ikruv udu da itəttir udu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a323" ANNOTATION_REF="a117">
                <ANNOTATION_VALUE>ipməngar-- ittir mərek nudu me ipməti mərek da bokbok ite, nəbo gəvənma urənga, to təton təbema uvi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a324" ANNOTATION_REF="a118">
                <ANNOTATION_VALUE>me ipməngar ite, molimolita təməngar tate, ubo o go təreuk kurek to udu duvok-- dukəbənət idə, da təda pən ma molimolita.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a325" ANNOTATION_REF="a119">
                <ANNOTATION_VALUE>io, me doto nəbət o itəttir udu, me ipəpumat nudu, o nəbo o ga kəvənau laike evi to immənəvən, iep to da bileir na logəvətak be tuk laik to vəduvədur idəmmanəng mənu idə, ubo pətpət dəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a326" ANNOTATION_REF="a120">
                <ANNOTATION_VALUE>tove umu o ve lovakəti to iləm mənəmbo ba ioiviok uvi to idəbunən mənəmbo, lovakəti to vəti tove kati dame kori ipvaləte, kori ipvaləte me kori iklotie təbəro, me dame avar udu duleir ne məte vət to avar udu dutəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a327" ANNOTATION_REF="a121">
                <ANNOTATION_VALUE>me do ip o ipvən kərot ne, ikloti təbəro.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a328" ANNOTATION_REF="a122">
                <ANNOTATION_VALUE>io kədikəne to iep, o itnave ippən, ianem (it--) idəttam, me pələpələp me kərukərung.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a329" ANNOTATION_REF="a123">
                <ANNOTATION_VALUE>me ioiviok o iləma vərrup mat tang nəbo nandi təkənəmə vəlleir na logəvətak nəbət bərənma tuk laik.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a330" ANNOTATION_REF="a124">
                <ANNOTATION_VALUE>idə to da vəduvədur idəmmanəng mənu idə da molimolita təppi ba tuk da nəmumə təkənəmu da ibən laikpət nəmumə be Keviang me Namatanai.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a331" ANNOTATION_REF="a125">
                <ANNOTATION_VALUE>doto itə-- ipəpu mat nudu nanbət, io ngang nga məlna ToVəninar, vəngar tuk ngang ate, 'ngali, ngibəlok tukip.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a332" ANNOTATION_REF="a126">
                <ANNOTATION_VALUE>'ngibəlok pəka tukip da tatəm.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a333" ANNOTATION_REF="a127">
                <ANNOTATION_VALUE>io, mata ngəməngar tukip, ngang ngəmume ip ngane, 'lulip na itnan.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a334" ANNOTATION_REF="a192">
                <ANNOTATION_VALUE>'tabət o tatobokbok tate, udu o dukəbənəta go təreuk kurek ubət da təda leir na molimolita, me nəbət o ipbət ipvən kərot na go tərea abət, o nəbət o kəvənav konənge evi to da etəmənəvən.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a335" ANNOTATION_REF="a128">
                <ANNOTATION_VALUE>'udu dumu kəvənave.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a336" ANNOTATION_REF="a129">
                <ANNOTATION_VALUE>'itəngar tuk ta iune, nəbo kəvənave to udu dumue da do to kəvənave etəmənəvən.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a337" ANNOTATION_REF="a130">
                <ANNOTATION_VALUE>'tove dumərimərit tang to udu o bədumata ioiviok nəmbo, me bəkori du go ioi gəmon da təda turən me nakən me tangədə.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a338" ANNOTATION_REF="a131">
                <ANNOTATION_VALUE>'bəkori du go ioi.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a339" ANNOTATION_REF="a132">
                <ANNOTATION_VALUE>'io, təre moli udu o dumatme dəm.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a340" ANNOTATION_REF="a133">
                <ANNOTATION_VALUE>'me dumatme dəm o kori go təreuk to leir to molimolita.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a341" ANNOTATION_REF="a134">
                <ANNOTATION_VALUE>'udu dumatme dəm o da kəvənave da etnəvən.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a342" ANNOTATION_REF="a135">
                <ANNOTATION_VALUE>'io məgət to tərevənik ubət to ava mərek idə, məgəte ubət akəukəu də latu, to akəukəu o kori ikəngəp doto vənua, me nəmumə o akəukəu avar bidəngngəp.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a343" ANNOTATION_REF="a136">
                <ANNOTATION_VALUE>'me ləvəkatə o ar idəngngəp'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a344" ANNOTATION_REF="a137">
                <ANNOTATION_VALUE>'idəmmang idə bətma vənua.'</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a345" ANNOTATION_REF="a138">
                <ANNOTATION_VALUE>doto ip ipməngar pəka tuk ta, o ta dame ava təmatme da kədikəne vədəm tang</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a346" ANNOTATION_REF="a139">
                <ANNOTATION_VALUE>təmatme da kədikəne vədəma ipvi ana va dərnge.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a347" ANNOTATION_REF="a140">
                <ANNOTATION_VALUE>io, ip o ikkərtang, doto bittəm ite, ip o bitleir, o ikkər tang o ipvərkəlat udu bətma Katiket man, me ikkəbənəta mətmət, da udu ava du-- ava durup tang.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a348" ANNOTATION_REF="a141">
                <ANNOTATION_VALUE>io, ta avar təməngar vəvat bema logəvətak uvi bərənma tuk laik to vuduvudur bəkori itamanəng nəmumə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a349" ANNOTATION_REF="a142">
                <ANNOTATION_VALUE>io duməngar pəka dune, ava kati dame avar udu dummane, to udu o-- udu dutəm da avar udu damane, o da-- da avar damane o avar mərek.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a350" ANNOTATION_REF="a144">
                <ANNOTATION_VALUE>da avar damane məte von to da damane.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a351" ANNOTATION_REF="a145">
                <ANNOTATION_VALUE>me ipbət o itleir to ipmate o (ipvalət--) ipvaləta rovənəm na apəkət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a352" ANNOTATION_REF="a146">
                <ANNOTATION_VALUE>io, nəbət o məgəte ip avar bə ip ipmatme də vət da ipmur kədikən ne da iep o imunman o ivən kərot.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a353" ANNOTATION_REF="a147">
                <ANNOTATION_VALUE>me kati avar udu dummane məte vət to da damane, o ebo ka kori matme da vətbət.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a354" ANNOTATION_REF="a148">
                <ANNOTATION_VALUE>tove nəbo o məgəte (be atae-- be) ba maoka iap to da nga məlna vatme dəm, vəkəbənət mate da du-- dukəbənət mate da duppi təpme da dumue, o nəbo o avar bokbok to vəmbokbok bem təkənəmu,</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a355" ANNOTATION_REF="a149">
                <ANNOTATION_VALUE>vəttəgər.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a356" ANNOTATION_REF="a150">
                <ANNOTATION_VALUE>io dame von to da avar dumane, o nəbo dame avar bokbok da avar (vəti--) vəti dəme.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a357" ANNOTATION_REF="a151">
                <ANNOTATION_VALUE>da vəmmane.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a358" ANNOTATION_REF="a152">
                <ANNOTATION_VALUE>io nga apir idil bema kəvənave nəmumə be New Ireland o toktok do.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a359" ANNOTATION_REF="a153">
                <ANNOTATION_VALUE>me ava mərek moli be idəmənamənan, me Laika bətmudu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a360" ANNOTATION_REF="a154">
                <ANNOTATION_VALUE>[INTERVIEWER SPEAKING]</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a361" ANNOTATION_REF="a155">
                <ANNOTATION_VALUE>to kapukapuk.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a362" ANNOTATION_REF="a156">
                <ANNOTATION_VALUE>eva vonbət o nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a363" ANNOTATION_REF="a157">
                <ANNOTATION_VALUE>ba maoka to vənua bəvətton, vətton vəvat, io ioiviok o bidəttə viok, bə iavava nandi ba ioiviok, bəkori da ava go ioivəbak nəmu ba ioiviok, iavava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a364" ANNOTATION_REF="a158">
                <ANNOTATION_VALUE>me mətmət o idəngəp, bidəmmang idə bətma vənua, məte ləvək, ubət akəukəu, to kori ikəngəp bətma vənua</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a365" ANNOTATION_REF="a159">
                <ANNOTATION_VALUE>ubət ar bidəmmang idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a366" ANNOTATION_REF="a160">
                <ANNOTATION_VALUE>ar bə kərekərerət idə, atopiok o avar bidəngəp.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a367" ANNOTATION_REF="a161">
                <ANNOTATION_VALUE>io, be vərete to ləmat, to ngitir ngang o ləmat o (doto amoli a da--) tove lokpənik nəmumə o tətəm mərek na per na ləmat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a368" ANNOTATION_REF="a162">
                <ANNOTATION_VALUE>kori məgəte udu do be Rəbəul to lokpənik o kori təttəma per na ləmat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a369" ANNOTATION_REF="a163">
                <ANNOTATION_VALUE>nəmumə be New Ireland, o lokpənik o təttəm mərek na per na ləmat.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a370" ANNOTATION_REF="a164">
                <ANNOTATION_VALUE>məgət o ka aperən ko na go ləmat mukəm magərung, balakətəria, libəti məgət be vəti təgəvon.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a371" ANNOTATION_REF="a165">
                <ANNOTATION_VALUE>mərek ko to vənua.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a372" ANNOTATION_REF="a166">
                <ANNOTATION_VALUE>me iap aperən konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a373" ANNOTATION_REF="a167">
                <ANNOTATION_VALUE>go idil konəng a məgəte ToPius, to ba vədo do konəng abo aperən, (tab(ət)- o) tətəm mərek.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a374" ANNOTATION_REF="a168">
                <ANNOTATION_VALUE>io doto lokpənik to da təpper na ləmat</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a375" ANNOTATION_REF="a169">
                <ANNOTATION_VALUE>doto təmmana ləmat təbe ibən, o vanəm o nginau bətəpma, o bəkori go ioi nəmu.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a376" ANNOTATION_REF="a170">
                <ANNOTATION_VALUE>me atirip moli a o nginata o abo ngitaləna nandi o kapukapuk bərodəma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a377" ANNOTATION_REF="a171">
                <ANNOTATION_VALUE>məgəte kərerəta.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a378" ANNOTATION_REF="a172">
                <ANNOTATION_VALUE>tove ioi o bəkori go təka nəmu ba tiriva, me bətomoma ioi nəmu ba tiriva.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a379" ANNOTATION_REF="a173">
                <ANNOTATION_VALUE>doto nginata mənəmu o ngitaləna o kapukapuk</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a380" ANNOTATION_REF="a174">
                <ANNOTATION_VALUE>io ti ngittən ngine, abət o kureka.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a381" ANNOTATION_REF="a175">
                <ANNOTATION_VALUE>kori, ləmata abo-- atiriva abo o məreka, nginda.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a382" ANNOTATION_REF="a176">
                <ANNOTATION_VALUE>me nginakəna, məie bə kori go ioi laik.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a383" ANNOTATION_REF="a177">
                <ANNOTATION_VALUE>bətomoma ioi nəmu bərodəma.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a384" ANNOTATION_REF="a178">
                <ANNOTATION_VALUE>io doto da dummata ubət atirip mən be ibən o kapukapuk</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a385" ANNOTATION_REF="a179">
                <ANNOTATION_VALUE>ngittaləna o kapukapuk.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a386" ANNOTATION_REF="a180">
                <ANNOTATION_VALUE>me ləmat kərerət o vanəm ar bə-- bəkori go ioi nəmu bərodəm, bidətəva ioi bərodəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a387" ANNOTATION_REF="a181">
                <ANNOTATION_VALUE>io məgəte tipur təgət ubət to ittuk ba lak, irir, to tattak bem tate irir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a388" ANNOTATION_REF="a182">
                <ANNOTATION_VALUE>to ittuk ba lak, ubət o ar bə kərekərerət idə, me ber, to idəttuk nəmu ba lak.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a389" ANNOTATION_REF="a183">
                <ANNOTATION_VALUE>me gəlom, ubət ar bə kərekərerət idə.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a390" ANNOTATION_REF="a184">
                <ANNOTATION_VALUE>ba maoka aumu o tate, ibəne ebət o məgəte lake o ubət o ar bə-- ar bidəttəp mərek, ar bə iavava.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a391" ANNOTATION_REF="a185">
                <ANNOTATION_VALUE>io nəbət o məte da ngəməti da tikilik to kakak emu itir ngang ete, me atirip to kapukapuk? eh? nga kakue, ngitir ngang nandi.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a392" ANNOTATION_REF="a186">
                <ANNOTATION_VALUE>atirip to kapukapuk o bə vənua bəvətton vareot, io bidəttəva ioi avar nəmu bərodəma ubət atirip.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a393" ANNOTATION_REF="a187">
                <ANNOTATION_VALUE>io doto da nginakəna, o bə kori nginakəna atirip təkədəma, me bə ioi o bətomom bə tikilik konəng.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a394" ANNOTATION_REF="a188">
                <ANNOTATION_VALUE>io nging lange da nginakən me bə kori nginakəna go laik, tove bidəttəva ioi bərodəm.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a395" ANNOTATION_REF="a189">
                <ANNOTATION_VALUE>mərek be ngi tir.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a396" ANNOTATION_REF="a190">
                <ANNOTATION_VALUE>me mərek.</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="Chenxi Meng" LINGUISTIC_TYPE_REF="symbolic_subdivision" PARENT_REF="utterance" PARTICIPANT="TL01" TIER_ID="grammatical_words">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a5569" ANNOTATION_REF="a211">
                <ANNOTATION_VALUE>#</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a410" ANNOTATION_REF="a211" PREVIOUS_ANNOTATION="a5569">
                <ANNOTATION_VALUE>ngang</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a411" ANNOTATION_REF="a211" PREVIOUS_ANNOTATION="a410">
                <ANNOTATION_VALUE>o</ANNOTATION_VALUE>
            </REF_ANNOTATION>
